<%= form_with(model: setlist) do |form| %>
  <% if setlist.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(setlist.errors.count, "error") %> prohibited this setlist from being saved:</h2>

      <ul>
        <% setlist.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :description, style: "display: block" %>
    <%= form.textarea :description %>
  </div>

  <div>
    <%= form.label :library_id, style: "display: block" %>
    <%= form.text_field :library_id %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
