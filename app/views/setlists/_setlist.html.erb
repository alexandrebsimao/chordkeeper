<div id="<%= dom_id setlist %>" class="space-y-4">
  <div>
    <h3 class="text-lg font-semibold text-gray-900">
      <%= setlist.title %>
    </h3>
  </div>

  <div class="mt-2">
    <p class="text-gray-600 text-sm">
      <% if setlist.description.present? %>
        <%= setlist.description %>
      <% else %>
        <span class="text-gray-400 italic">Sem descrição</span>
      <% end %>
    </p>
  </div>

  <% if params[:action] != "index" && setlist.public_setlist.present? %>
    <!-- Componente de Compartilhamento -->
    <div class="bg-white rounded-lg border border-gray-200 p-6">
        <h2 class="text-sm font-semibold text-gray-900 mb-4 uppercase tracking-wide">Compartilhar</h2>
        
        <div class="flex flex-col sm:flex-row gap-6 items-center">
            <!-- Seção de Link -->
            <div class="flex-1 w-full">
                <p class="text-xs text-gray-500 mb-2 uppercase tracking-wide">Link de Compartilhamento</p>
                <div class="flex gap-2">
                    <input 
                        type="text" 
                        id="shareLink"
                        value="<%= public_setlist_url(setlist.public_setlist.uuid) %>" 
                        readonly
                        class="flex-1 px-3 py-2 text-sm bg-gray-50 border border-gray-300 rounded text-gray-700 focus:outline-none"
                    >
                    <button 
                        onclick="copiarLink()"
                        class="px-4 py-2 bg-gray-900 text-white text-sm font-medium rounded hover:bg-gray-800 transition-colors"
                    >
                        Copiar
                    </button>
                </div>
            </div>

            <!-- Divisor -->
            <div class="hidden sm:block w-px h-20 bg-gray-200"></div>

            <!-- Seção de QR Code -->
            <div class="flex flex-col items-center">
                <p class="text-xs text-gray-500 mb-3 uppercase tracking-wide">QR Code</p>
                <%= raw gerar_qr_code_svg(public_setlist_url(setlist.public_setlist.uuid)) %>
            </div>
        </div>
    </div>

  <% end %>

  <div class="flex items-center space-x-4 text-sm text-gray-500 mt-4">
    <div class="flex items-center">
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <span>Atualizada em <%= setlist.updated_at.strftime("%d/%m/%Y") %></span>
    </div>
  </div>

  <div class="mt-2 flex items-center text-sm text-gray-500">
    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"></path>
    </svg>
    <span><%= setlist.songs.count %> músicas</span>
  </div>
</div>
