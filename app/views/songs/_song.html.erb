<div id="<%= dom_id song %>" class="space-y-6">
  <div class="border-b border-gray-200 pb-4">
    <h3 class="text-lg font-semibold text-gray-900">
      <%= song.title %>
    </h3>
    <p class="text-sm text-gray-600">
      <%= song.artist %>
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-1 gap-6">
    <div class="space-y-4">
      <div>
        <h4 class="text-sm font-medium text-gray-500 uppercase">Informações Técnicas</h4>
        <div class="mt-2 space-y-2">
          <% unless song.key.present? || song.bpm.present? || song.genre.present? %>
            <span class="text-gray-400 italic">Sem informações</span>
          <% end %>
          <% if song.key.present? %>
            <span class="font-medium">Tom:</span>
            <% if song.attachment.present? && !song.convert_pdf %>
              <%= song.key %>
            <% else %>
              <select onchange="onTransposeKeyChange(this, <%= song.id %>)" class="">
                <option value="">Transpor Tom</option>
                <% Song::NOTES.each do |note| %>
                  <option value="<%= note %>" <%= 'selected' if song.key == note %>>
                    <%= note %>
                    <% if song.original_key == note %>
                      (Original)
                    <% end %>
                  </option>
                <% end %>
              </select>
            <% end %>
          <% end %>

          <% if song.bpm.present? %>
            <span class="font-medium">BPM:</span> <%= song.bpm %>
          <% end %>
          <% if song.genre.present? %>
            <span class="font-medium">Gênero:</span> <%= song.genre %>
          <% end %>
        </div>
      </div>
    </div>

    <div class="space-y-4">
      <% if song.content.present? && params['action'] != 'index' %>
        <div>
          <h4 class="text-sm font-medium text-gray-500 uppercase">
            Conteúdo
          </h4>
          <div class="mt-2 p-4 bg-gray-50 rounded-lg font-mono text-sm">
            <pre class="whitespace-pre-wrap">
              <%= song.transpose_key.present? ? song.transposed_content(song.transpose_key) : song.content %>
            </pre>
          </div>
        </div>
      <% end %>

      <% if song.attachment.present? && params['action'] != 'index' %>
        <div>
          <h4 class="text-sm font-medium text-gray-500 uppercase">Anexo</h4>
          <div class="mt-2">
            <%= link_to song.attachment, class: "inline-flex items-center text-blue-600 hover:text-blue-800" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span>Baixar anexo</span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="mt-4 pt-4 border-t border-gray-200 text-sm text-gray-500">
    <div class="flex items-center space-x-4">
      <div class="flex items-center">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span>Atualizada em <%= song.updated_at.strftime("%d/%m/%Y") %></span>
      </div>
    </div>
  </div>
</div>

<script>
  function onTransposeKeyChange(selectElement, id) {
    const selectedKey = selectElement.value;
    const url = new URL(`/songs/${id}/transpose`, window.location.origin);

    fetch(url, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
      },
      body: JSON.stringify({ transpose_key: selectedKey })
    }).then(response => {
      if (response.ok) {
        window.location.reload();
      } else {
        alert('Erro ao transpor a música.');
      }
    });
  }
</script>