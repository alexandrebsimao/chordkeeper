<%= form_with(model: song, class: "space-y-6") do |form| %>
  <% if song.errors.any? %>
    <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-6">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">
            <%= pluralize(song.errors.count, "erro") %> impediram que esta música fosse salva:
          </h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc pl-5 space-y-1">
              <% song.errors.each do |error| %>
                <li><%= error.full_message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="space-y-2">
      <%= form.label :title, "Título", class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :title, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm", placeholder: "Digite o título da música" %>
    </div>

    <div class="space-y-2">
      <%= form.label :artist, "Artista", class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :artist, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm", placeholder: "Digite o nome do artista" %>
    </div>

    <div class="space-y-2">
      <%= form.label :genre, "Gênero", class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :genre, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm", placeholder: "Digite o gênero musical" %>
    </div>

    <div class="space-y-2">
      <%= form.label :original_key, "Tom original", class: "block text-sm font-medium text-gray-700" %>
      <%= form.select :original_key,
          Song::NOTES,
          { include_blank: 'Selecione o tom' },
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
    </div>

    <div class="space-y-2">
      <%= form.label :transpose_key, "Transpor Tom", class: "block text-sm font-medium text-gray-700" %>
      <%= form.select :transpose_key,
          Song::NOTES,
          { include_blank: 'Selecione o tom' },
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>    </div>

    <div class="space-y-2">
      <%= form.label :bpm, "BPM", class: "block text-sm font-medium text-gray-700" %>
      <%= form.number_field :bpm, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm", placeholder: "Digite o BPM da música" %>
    </div>
  </div>

  <div class="mt-6">
    <div class="border-b border-gray-200">
      <nav class="-mb-px flex" aria-label="Tabs">
        <button type="button" data-tab="content" class="tab-button w-1/2 py-4 px-1 text-center border-b-2 font-medium text-sm cursor-pointer">
          <svg class="w-5 h-5 mx-auto mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Inserir Cifra
        </button>
        <button type="button" data-tab="attachment" class="tab-button w-1/2 py-4 px-1 text-center border-b-2 font-medium text-sm cursor-pointer">
          <svg class="w-5 h-5 mx-auto mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
          </svg>
          Anexar Arquivo
        </button>
      </nav>
    </div>

    <div class="mt-6">
      <div id="content-tab" class="tab-content">
        <div class="space-y-2">
          <%= form.label :content, "Cifra <span class='text-gray-400 italic'>A edição da cifra será no tom original quando foi salvo a música</span>".html_safe, class: "block text-sm font-medium text-gray-700" %>
          <%= 
            form.text_area :content, rows: 20, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm font-mono", placeholder: 
            "Digite a letra e cifra da música. Ex.:
[Intro] E  A9  E  A9

[Primeira Parte] (2x)

E               A9
  Este é o meu respirar
E               A9
  Este é o meu respirar"
          %>
        </div>
      </div>

      <div id="attachment-tab" class="tab-content hidden">
        <div class="space-y-2">
          <%= form.label :attachment, "Arquivo", class: "block text-sm font-medium text-gray-700" %>
          <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-gray-300 border-dashed rounded-md">
            <div class="space-y-1 text-center">
              <svg class="mx-auto h-12 w-12 text-gray-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/>
                <polyline points="13 2 13 9 20 9"/>
              </svg>
              <div class="flex text-sm text-gray-600">
                <label for="song_attachment" class="relative cursor-pointer bg-white rounded-md font-medium text-blue-600 hover:text-blue-500 focus-within:outline-none focus-within:ring-2 focus-within:ring-offset-2 focus-within:ring-blue-500">
                  <span>Envie um arquivo</span>
                  <%= form.file_field :attachment, class: "sr-only" %>
                </label>
                <p class="pl-1">ou arraste e solte</p>
              </div>
              <p class="text-xs text-gray-500">PDF até 10MB</p>
            </div>
          </div>
          <div id="file-name" class="mt-2 text-sm text-gray-600">
            <% if song.attachment.attached? %>
              Arquivo atual: <%= song.attachment.filename.to_s %>
            <% end %>
          </div>

          <!-- Converter PDF para texto -->

          <div class="mt-4 p-4 bg-yellow-50 border-l-4 border-yellow-400">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-yellow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div class="ml-3">
                <p class="text-sm text-yellow-700">
                  Dica: Após anexar um arquivo PDF, você pode salvar a música e depois editar para ajustar o conteúdo extraído.
                </p>
              </div>
            </div>
        </div>

        <!-- checkbox para converter PDF em texto -->
        <%= form.check_box :convert_pdf, {}, true, false %>
        <%= form.label :convert_pdf, "Converter PDF para texto ao salvar", class: "ml-2 text-sm text-gray-700" %>

      </div>
  </div>

  <div class="mt-6">
    <h3 class="text-lg font-medium text-gray-900 mb-4">Referências de Mídia</h3>
    
    <div class="media-references" data-controller="nested-form">
      <template data-nested-form-target="template">
        <%= form.fields_for :media_references, MediaReference.new, child_index: 'NEW_RECORD' do |media_form| %>
          <div class="nested-fields bg-gray-50 p-4 rounded-lg mb-4" data-new-record="true" data-controller="media-form">
            <%= media_form.hidden_field :_destroy %>
            <div class="grid grid-cols-1 gap-4">
              <div>
                <%= media_form.label :media_type, "Tipo de Referência", class: "block text-sm font-medium text-gray-700" %>
                <%= media_form.select :media_type,
                    [['Link', 'url'],
                     ['Arquivo', 'file']],
                    { prompt: "Selecione o tipo de referência" },
                    class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm",
                    data: { action: "change->media-form#toggleReferenceType" } %>
              </div>

              <div data-media-form-target="urlField" class="hidden">
                <%= media_form.label :url, "URL", class: "block text-sm font-medium text-gray-700" %>
                <%= media_form.text_field :url, 
                    class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", 
                    placeholder: "https://" %>
              </div>

              <div data-media-form-target="fileField" class="hidden">
                <%= media_form.label :attachment, "Arquivo", class: "block text-sm font-medium text-gray-700" %>
                <%= media_form.file_field :attachment,
                    class: "mt-1 block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100",
                    accept: ".mp3,.wav,.ogg,audio/*,video/*" %>
              </div>

              <div>
                <%= media_form.label :description, "Descrição", class: "block text-sm font-medium text-gray-700" %>
                <%= media_form.text_field :description, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", placeholder: "Descreva esta referência..." %>
              </div>

              <div class="text-right">
                <button type="button" data-action="nested-form#remove" class="inline-flex items-center px-3 py-2 border border-transparent text-sm leading-4 font-medium rounded-md text-red-700 bg-red-100 hover:bg-red-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
                  Remover
                </button>
              </div>
            </div>
          </div>
        <% end %>
      </template>

      <div data-nested-form-target="target">
        <%= form.fields_for :media_references do |media_form| %>
          <div class="nested-fields bg-gray-50 p-4 rounded-lg mb-4" data-controller="media-form">
            <%= media_form.hidden_field :_destroy %>
            <%= media_form.hidden_field :id if media_form.object.persisted? %>
            
            <div class="grid grid-cols-1 gap-4">
              <div>
                <%= media_form.label :media_type, "Tipo de Referência", class: "block text-sm font-medium text-gray-700" %>
                <%= media_form.select :media_type,
                    [['Link', 'url'],
                     ['Arquivo', 'file']],
                    { prompt: "Selecione o tipo de referência" },
                    class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm",
                    data: { 
                      action: "change->media-form#toggleReferenceType",
                      'media-form-reference-type-param': media_form.object.attachment.attached? ? 'file' : 'url'
                    } %>
              </div>

              <div data-media-form-target="urlField" class="<%= media_form.object.attachment.attached? ? 'hidden' : '' %>">
                <%= media_form.label :url, "URL", class: "block text-sm font-medium text-gray-700" %>
                <%= media_form.text_field :url, 
                    class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", 
                    placeholder: "https://" %>
              </div>

              <div data-media-form-target="fileField" class="<%= media_form.object.attachment.attached? ? '' : 'hidden' %>">
                <%= media_form.label :attachment, "Arquivo", class: "block text-sm font-medium text-gray-700" %>
                <% if media_form.object.attachment.attached? %>
                  <div class="mb-2 text-sm text-gray-600">
                    Arquivo atual: <%= media_form.object.attachment.filename %>
                  </div>
                <% end %>
                <%= media_form.file_field :attachment,
                    class: "mt-1 block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100",
                    accept: ".mp3,.wav,.ogg,audio/*,video/*" %>
              </div>

              <div>
                <%= media_form.label :description, "Descrição", class: "block text-sm font-medium text-gray-700" %>
                <%= media_form.text_field :description, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", placeholder: "Descreva esta referência..." %>
              </div>

              <div class="text-right">
                <button type="button" data-action="nested-form#remove" class="inline-flex items-center px-3 py-2 border border-transparent text-sm leading-4 font-medium rounded-md text-red-700 bg-red-100 hover:bg-red-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
                  Remover
                </button>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <div class="mt-4">
        <button type="button" 
                data-action="click->nested-form#add" 
                class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-indigo-700 bg-indigo-100 hover:bg-indigo-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          Adicionar Nova Referência
        </button>
      </div>
    </div>
  </div>

<%= javascript_tag do %>
  document.addEventListener('DOMContentLoaded', function() {
    const tabButtons = document.querySelectorAll('.tab-button');
    const tabContents = document.querySelectorAll('.tab-content');
    const contentTextarea = document.querySelector('#song_content');
    const attachmentInput = document.querySelector('#song_attachment');
    let activeTab = 'content';

    // Adiciona evento de mudança
    attachmentInput.addEventListener('change', function(event) {
      // Obtém o arquivo selecionado
      const file = event.target.files[0];
      
      // Verifica se um arquivo foi selecionado
      if (file) {
        // Exibe o nome do arquivo na div
        document.querySelector('#file-name').textContent = file.name;
      }
    });

    // Função para atualizar a aparência dos botões
    function updateTabButtons() {
      tabButtons.forEach(button => {
        const tabName = button.dataset.tab;
        if (tabName === activeTab) {
          button.classList.add('border-blue-500', 'text-blue-600');
          button.classList.remove('border-transparent', 'text-gray-500', 'hover:text-gray-700', 'hover:border-gray-300');
        } else {
          button.classList.remove('border-blue-500', 'text-blue-600');
          button.classList.add('border-transparent', 'text-gray-500', 'hover:text-gray-700', 'hover:border-gray-300');
        }
      });
    }

    // Função para mostrar/esconder conteúdo das abas
    function updateTabContents() {
      tabContents.forEach(content => {
        if (content.id === `${activeTab}-tab`) {
          content.classList.remove('hidden');
        } else {
          content.classList.add('hidden');
        }
      });
    }

    // Função para limpar campos não ativos
    function clearInactiveFields() {
      if (activeTab === 'content') {
        attachmentInput.value = '';
      } else {
        contentTextarea.value = '';
      }
    }

    // Inicializar estado das abas
    updateTabButtons();

    // Event listeners para os botões das abas
    tabButtons.forEach(button => {
      button.addEventListener('click', () => {
        const newTab = button.dataset.tab;
        if (newTab !== activeTab) {
          activeTab = newTab;
          updateTabButtons();
          updateTabContents();
          clearInactiveFields();
        }
      });
    });

    // Event listener para o formulário
    const form = document.querySelector('form');
    form.addEventListener('submit', function(e) {
      const hasContent = contentTextarea.value.trim().length > 0;
      const hasAttachment = attachmentInput.files.length > 0;

      if (hasContent && hasAttachment) {
        e.preventDefault();
        alert('Por favor, escolha apenas uma opção: inserir conteúdo ou anexar arquivo.');
      } else if (!hasContent && !hasAttachment) {
        e.preventDefault();
        alert('Por favor, insira o conteúdo ou anexe um arquivo.');
      }
    });
  });
<% end %>

  </div>

  <div class="pt-4">
    <%= form.submit "Salvar", class: "w-full sm:w-auto px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors duration-200" %>
  </div>
<% end %>
