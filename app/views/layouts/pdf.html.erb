<html>
  <head>
    <meta charset="UTF-8">
    <style>
      @font-face {
        font-family: 'DejaVu Sans Mono';
        src: url('https://cdn.jsdelivr.net/npm/@fontsource/dejavu-sans-mono@4.5.4/files/dejavu-sans-mono-latin-400-normal.woff2') format('woff2');
      }
      
      body {
        margin: 30px;
        background: white;
        font-family: 'DejaVu Sans Mono', monospace;
      }

      .header {
        margin-bottom: 30px;
      }

      .title {
        font-size: 24px;
        font-weight: bold;
        margin-bottom: 5px;
        font-family: Arial, sans-serif;
      }

      .subtitle {
        font-size: 16px;
        color: #666;
        margin-bottom: 5px;
        font-family: Arial, sans-serif;
      }

      .metadata {
        font-size: 14px;
        color: #888;
        margin-bottom: 20px;
        font-family: Arial, sans-serif;
      }

      .content {
        padding: 20px;
        background-color: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 4px;
      }

      .content > div {
        margin-bottom: 2px;
      }

      /* Garante fonte monospace consistente para acordes */
      .chord-line {
        font-family: 'Courier New', monospace !important;
        font-size: 14px !important;
        color: #ec4899;
        font-weight: bold;
        line-height: 1.4 !important;
      }

      .lyrics-line {
        font-family: 'Courier New', monospace !important;
        font-size: 14px !important;
        color: #1e293b;
        line-height: 1.4 !important;
      }

      /* Preserva espaçamento e formatação monospace onde necessário */
      .content div[style*="white-space: pre"] {
        font-family: 'Courier New', monospace;
      }

      /* Estilos para acordes */
      .chord {
        color: #ec4899;
        font-weight: bold;
      }

      .notation {
        color: #d97706;
        font-style: italic;
      }

      @media print {
        body {
          margin: 0;
          padding: 20px;
        }

        .content {
          border: none;
          padding: 0;
          background: none;
        }

        .page-break {
          page-break-after: always;
        }
      }
    </style>
  </head>
  <body>
    <%= yield %>
  </body>
</html>