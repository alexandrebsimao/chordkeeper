<div data-sidebar-target="overlay" data-action="click->sidebar#toggle" class="fixed inset-0 z-30 hidden bg-black/50 md:hidden"></div>

<aside data-sidebar-target="sidebar" class="fixed inset-y-0 left-0 z-40 flex h-svh w-64 -translate-x-full flex-col border-r border-sidebar-border bg-sidebar text-sidebar-foreground transition-transform duration-200 ease-linear md:translate-x-0">
  <div class="border-b border-sidebar-border px-6 py-4">
    <div class="flex items-center justify-between">
      <%= link_to songs_path, class: "flex items-center" do %>
        <%= image_tag "logo-cifrary.png", alt: "ChordKeeper", class: "h-16 w-auto" %>
      <% end %>

      <button type="button" data-action="sidebar#toggle" class="inline-flex h-8 w-8 items-center justify-center rounded-xl hover:bg-sidebar-accent md:hidden" aria-label="Fechar menu">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <div class="flex-1 overflow-y-auto px-3 py-4">
    <nav class="space-y-1">
      <%= link_to songs_path, class: "flex items-center gap-3 rounded-xl px-3 py-2 text-sm font-medium transition-colors hover:bg-sidebar-accent/80 #{current_page?(songs_path) ? 'bg-sidebar-accent text-sidebar-primary' : ''}" do %>
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
        </svg>
        <span>Minhas Cifras</span>
      <% end %>

      <% if can_edit_library? %>
        <%= link_to new_song_path, class: "flex items-center gap-3 rounded-xl px-3 py-2 text-sm font-medium transition-colors hover:bg-sidebar-accent/80 #{current_page?(new_song_path) ? 'bg-sidebar-accent text-sidebar-primary' : ''}" do %>
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          <span>Adicionar Cifra</span>
        <% end %>
      <% end %>

      <a href="/setlists" class="flex items-center gap-3 rounded-xl px-3 py-2 text-sm font-medium transition-colors hover:bg-sidebar-accent/80">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11h8M8 15h6"/>
        </svg>
        <span>Setlists</span>
      </a>
    </nav>
  </div>

  <div class="border-t border-sidebar-border px-3 py-4">
    <div class="mb-3 flex items-center gap-3 px-1">
      <div class="flex h-8 w-8 items-center justify-center rounded-full bg-sidebar-accent text-sm font-semibold text-sidebar-primary">
        <%= (current_user&.name.presence || current_user&.email.to_s).first&.upcase %>
      </div>
      <div class="min-w-0">
        <p class="truncate text-sm font-semibold"><%= current_user&.name.presence || current_user&.email %></p>
      </div>
    </div>

    <div class="space-y-1">
      <%= link_to edit_user_registration_path, class: "flex items-center gap-3 rounded-xl px-3 py-2 text-sm font-medium transition-colors hover:bg-sidebar-accent/60" do %>
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        <span>Configurações</span>
      <% end %>

      <%= button_to destroy_user_session_path, method: :delete, class: "flex w-full items-center gap-3 rounded-xl px-3 py-2 text-sm font-medium transition-colors hover:bg-sidebar-accent/60" do %>
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
        </svg>
        <span>Sair</span>
      <% end %>
    </div>
  </div>
</aside>
