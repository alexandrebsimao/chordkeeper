<div data-sidebar-target="sidebar" class="fixed left-0 top-0 bottom-0 flex flex-col items-center w-64 h-screen overflow-y-auto text-gray-400 bg-gray-900 transform transition-transform duration-300 ease-in-out -translate-x-full md:translate-x-0 z-30">
  <div class="flex items-center justify-between w-full px-3 mt-3">
    <a class="flex items-center" href="">
      <%
=begin%>
      <%= image_tag "logo-sidebar.png", class: "h-12 w-auto", alt: "Planapê" %> 
      <%
=end%>
    </a>
    <button class="p-2 rounded-md hover:bg-gray-700 md:hidden" data-action="sidebar#toggle">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <div class="w-full px-2 flex-grow overflow-y-auto">
    <div class="flex flex-col items-center w-full mt-3 border-t border-gray-700">      
      <div class="w-full px-3 mt-2" data-controller="library-selector">
        <div class="flex items-center justify-between mb-1">
          <h3 class="text-sm font-medium text-gray-400">Biblioteca</h3>
          <div class="flex items-center space-x-1">
            <%= link_to new_library_path, class: "p-1 rounded hover:bg-gray-700 text-gray-400 hover:text-gray-300" do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
              </svg>
            <% end %>

            <% if current_library %>
              <div class="relative" data-library-selector-target="actions">
                <button type="button"
                        data-action="library-selector#toggleActions"
                        class="p-1 rounded hover:bg-gray-700 text-gray-400 hover:text-gray-300"
                        title="Opções da biblioteca">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                  </svg>
                </button>
                <div data-library-selector-target="actionMenu" 
                     class="absolute right-0 mt-1 w-48 py-1 bg-gray-800 rounded shadow-lg hidden border border-gray-700 z-20">
                  <%= link_to edit_library_path(current_library), 
                        class: "flex items-center px-4 py-2 text-sm text-gray-400 hover:bg-gray-700 hover:text-gray-300" do %>
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                    <span>Editar biblioteca</span>
                  <% end %>
                  
                  <button data-action="click->library-selector#deleteLibrary" 
                          data-library-id="<%= current_library.id %>"
                          class="flex items-center w-full px-4 py-2 text-sm text-gray-400 hover:bg-gray-700 hover:text-gray-300">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                    </svg>
                    <span>Excluir biblioteca</span>
                  </button>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <% if current_user.libraries.count > 1 %>
          <div class="relative" data-library-selector-target="container">
            <button type="button" 
                    data-action="library-selector#toggleDropdown"
                    class="w-full flex items-center justify-between px-3 py-2 text-sm rounded bg-gray-700 text-gray-300 hover:bg-gray-600">
              <span class="flex-1 text-left">
                <%= current_library ? [current_library.name[0..20], '...'].join : "Selecione uma biblioteca" %>
              </span> 
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>

            <div data-library-selector-target="dropdown" 
                class="absolute w-full mt-1 py-1 bg-gray-800 rounded shadow-lg hidden border border-gray-700 z-10">
              <% current_user.libraries.each do |library| %>
                <%= link_to define_scope_library_path(library), 
                    class: "flex items-center justify-between px-3 py-2 text-sm hover:bg-gray-700 #{params[:library_id].to_i == library.id ? 'text-gray-300' : 'text-gray-400'}" do %>
                  <span class="flex-1"><%= library.name %></span>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <a class="flex items-center w-full h-12 px-3 mt-2 rounded hover:bg-gray-700 hover:text-gray-300" href="<%= songs_path %>">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"></path>
        </svg>
        <span class="ml-2 text-sm font-medium">Músicas</span>
      </a>

      <a class="flex items-center w-full h-12 px-3 mt-2 rounded hover:bg-gray-700 hover:text-gray-300" href="<%= setlists_path %>">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2M20 12v-2a2 2 0 00-2-2h-2M6 12h.01M6 16h.01M13 12h4"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 18a2 2 0 100-4 2 2 0 000 4z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 16V8"/>
        </svg>
        <span class="ml-2 text-sm font-medium">Setlists</span>
      </a>
    </div>
  </div>

  <div class="relative w-full mt-2 border-t border-gray-700">
    <button class="flex items-center w-full h-12 px-3 mt-2 rounded hover:bg-gray-700 hover:text-gray-300" id="userDropdownButton">
      <svg class="w-6 h-6 stroke-current" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A4 4 0 0112 15a4 4 0 016.879 2.804M12 7a4 4 0 110-8 4 4 0 010 8z" />
      </svg>
      <span class="ml-2 text-sm font-medium"><%= current_user&.email %></span>
    </button>
    <ul class="hidden absolute left-0 w-full bg-gray-800 rounded shadow-lg" id="userDropdownMenu">
      <li><a href="<%= edit_user_registration_path %>" class="block px-4 py-2 hover:bg-gray-700 rounded">Configurações</a></li>
      <li><%= button_to "Logout", destroy_user_session_path, method: :delete, class: "block px-4 py-2 hover:bg-gray-700 rounded" %></li>
    </ul>
  </div>
</div>
