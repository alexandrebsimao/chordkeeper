          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20h6M4 20h5v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75M8 3.13a4 4 0 010 7.75M12 7v.01" />
        </svg>
        <span class="ml-2 text-sm font-medium">Fornecedores e prestadores</span>
      </a>

      <a class="flex items-center w-full h-12 px-3 mt-2 rounded hover:bg-gray-700 hover:text-gray-300" href="">
        <svg class="w-6 h-6 stroke-current" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        <span class="ml-2 text-sm font-medium">Cômodos</span>
      </a>
    </div>

    <div class="flex flex-col items-center w-full mt-2 border-t border-gray-700">
      <div class="relative w-full">
        <button class="flex items-center w-full h-12 px-3 mt-2 rounded hover:bg-gray-700 hover:text-gray-300" id="dropdownButton">
          <svg class="w-6 h-6 stroke-current" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
          </svg>
          <span class="ml-2 text-sm font-medium">Configurações do projeto</span>
        </button>
        <ul class="hidden absolute left-0 w-full mt-2 bg-gray-800 rounded shadow-lg" id="dropdownMenu">
          <li><a href="" class="block px-4 py-2 hover:bg-gray-700 rounded">Tags</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="relative w-full mt-2 border-t border-gray-700">
    <button class="flex items-center w-full h-12 px-3 mt-2 rounded hover:bg-gray-700 hover:text-gray-300" id="userDropdownButton">
      <svg class="w-6 h-6 stroke-current" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A4 4 0 0112 15a4 4 0 016.879 2.804M12 7a4 4 0 110-8 4 4 0 010 8z" />
      </svg>
      <span class="ml-2 text-sm font-medium"><%= current_user&.email %></span>
    </button>
    <ul class="hidden absolute left-0 w-full bg-gray-800 rounded shadow-lg" id="userDropdownMenu">
      <li><a href="<%= edit_user_registration_path %>" class="block px-4 py-2 hover:bg-gray-700 rounded">Configurações</a></li>
      <li><%= button_to "Logout", destroy_user_session_path, method: :delete, class: "block px-4 py-2 hover:bg-gray-700 rounded" %></li>
    </ul>
  </div>
</div>
