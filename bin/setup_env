#!/bin/bash

# Script de Configuração de Variáveis de Ambiente
# Chord Keeper Setup Helper

set -e

echo "🔧 =================================="
echo "   Chord Keeper - Setup Helper"
echo "===================================="
echo ""

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to generate a secure random secret
generate_secret() {
    if command -v openssl &> /dev/null; then
        openssl rand -hex 64
    else
        # Fallback to /dev/urandom
        cat /dev/urandom | LC_ALL=C tr -dc 'a-zA-Z0-9' | fold -w 128 | head -n 1
    fi
}

# Check if .env already exists
if [ -f .env ]; then
    echo -e "${YELLOW}⚠️  .env file already exists!${NC}"
    read -p "Do you want to overwrite it? (y/N): " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "Setup cancelled."
        exit 0
    fi
    mv .env .env.backup.$(date +%Y%m%d_%H%M%S)
    echo -e "${GREEN}✅ Backup created${NC}"
fi

echo "📋 Setting up environment variables..."
echo ""

# Copy example file
if [ -f .env.example ]; then
    cp .env.example .env
    echo -e "${GREEN}✅ Created .env from .env.example${NC}"
else
    echo -e "${RED}❌ .env.example not found!${NC}"
    exit 1
fi

echo ""
echo "🔑 Generating secure secrets..."
echo ""

# Generate JWT Secret
JWT_SECRET=$(generate_secret)
if [ -n "$JWT_SECRET" ]; then
    sed -i.bak "s|DEVISE_JWT_SECRET_KEY=.*|DEVISE_JWT_SECRET_KEY=$JWT_SECRET|g" .env
    echo -e "${GREEN}✅ Generated DEVISE_JWT_SECRET_KEY${NC}"
else
    echo -e "${YELLOW}⚠️  Could not generate JWT secret automatically${NC}"
fi

# Generate Secret Key Base
SECRET_BASE=$(generate_secret)
if [ -n "$SECRET_BASE" ]; then
    # Add SECRET_KEY_BASE if not present
    if ! grep -q "SECRET_KEY_BASE=" .env; then
        echo "" >> .env
        echo "# Generated by setup script" >> .env
        echo "SECRET_KEY_BASE=$SECRET_BASE" >> .env
        echo -e "${GREEN}✅ Generated SECRET_KEY_BASE${NC}"
    fi
fi

# Remove backup file
rm -f .env.bak

echo ""
echo "📝 Configuration prompts..."
echo ""

# Database Password
read -p "Enter database password [default: chordkeeper]: " DB_PASSWORD
DB_PASSWORD=${DB_PASSWORD:-chordkeeper}
sed -i.bak "s|DATABASE_PASSWORD=.*|DATABASE_PASSWORD=$DB_PASSWORD|g" .env

# Domain Name
read -p "Enter domain name [default: http://localhost:3000]: " DOMAIN
DOMAIN=${DOMAIN:-http://localhost:3000}
sed -i.bak "s|DOMAIN_NAME=.*|DOMAIN_NAME=$DOMAIN|g" .env

# Frontend URL
read -p "Enter frontend URL [default: http://localhost:8080]: " FRONTEND
FRONTEND=${FRONTEND:-http://localhost:8080}
sed -i.bak "s|FRONTEND_URL=.*|FRONTEND_URL=$FRONTEND|g" .env

# Clean up backup files
rm -f .env.bak

echo ""
echo -e "${BLUE}🔐 Optional configurations (press Enter to skip):${NC}"
echo ""

# Google OAuth
read -p "Enter Google Client ID (or press Enter to skip): " GOOGLE_ID
if [ -n "$GOOGLE_ID" ]; then
    sed -i.bak "s|GOOGLE_CLIENT_ID=.*|GOOGLE_CLIENT_ID=$GOOGLE_ID|g" .env
    
    read -p "Enter Google Client Secret: " GOOGLE_SECRET
    if [ -n "$GOOGLE_SECRET" ]; then
        sed -i.bak "s|GOOGLE_CLIENT_SECRET=.*|GOOGLE_CLIENT_SECRET=$GOOGLE_SECRET|g" .env
        echo -e "${GREEN}✅ Google OAuth configured${NC}"
    fi
fi

# Stripe
read -p "Enter Stripe Secret Key (or press Enter to skip): " STRIPE_KEY
if [ -n "$STRIPE_KEY" ]; then
    if ! grep -q "STRIPE_SECRET_KEY=" .env; then
        echo "" >> .env
        echo "# Stripe Configuration" >> .env
        echo "STRIPE_SECRET_KEY=$STRIPE_KEY" >> .env
    else
        sed -i.bak "s|STRIPE_SECRET_KEY=.*|STRIPE_SECRET_KEY=$STRIPE_KEY|g" .env
    fi
    
    read -p "Enter Stripe Webhook Secret: " STRIPE_WEBHOOK
    if [ -n "$STRIPE_WEBHOOK" ]; then
        if ! grep -q "STRIPE_WEBHOOK_SECRET=" .env; then
            echo "STRIPE_WEBHOOK_SECRET=$STRIPE_WEBHOOK" >> .env
        else
            sed -i.bak "s|STRIPE_WEBHOOK_SECRET=.*|STRIPE_WEBHOOK_SECRET=$STRIPE_WEBHOOK|g" .env
        fi
        echo -e "${GREEN}✅ Stripe configured${NC}"
    fi
fi

# Clean up any remaining backup files
rm -f .env.bak

echo ""
echo "🎨 Setting up frontend environment..."
echo ""

# Frontend setup
if [ -d "frontend" ]; then
    cd frontend
    
    if [ -f .env.example ]; then
        if [ -f .env ]; then
            echo -e "${YELLOW}⚠️  frontend/.env already exists${NC}"
        else
            cp .env.example .env
            
            # Update API URL based on backend domain
            sed -i.bak "s|VITE_API_URL=.*|VITE_API_URL=$DOMAIN|g" .env
            rm -f .env.bak
            
            echo -e "${GREEN}✅ Created frontend/.env${NC}"
        fi
    fi
    
    cd ..
else
    echo -e "${YELLOW}⚠️  Frontend directory not found${NC}"
fi

echo ""
echo "✅ =================================="
echo "   Setup Complete!"
echo "===================================="
echo ""
echo "📁 Files created:"
echo "   - .env (backend)"
echo "   - frontend/.env (frontend)"
echo ""
echo "🔐 Secrets generated:"
echo "   - DEVISE_JWT_SECRET_KEY"
echo "   - SECRET_KEY_BASE"
echo ""
echo "📝 Next steps:"
echo ""
echo "1. Review your .env file:"
echo "   ${BLUE}vim .env${NC}"
echo ""
echo "2. Update any remaining variables (Google OAuth, Stripe, etc)"
echo ""
echo "3. Start the application:"
echo "   ${BLUE}docker-compose down${NC}"
echo "   ${BLUE}docker-compose up${NC}"
echo ""
echo "4. Run database migrations:"
echo "   ${BLUE}docker-compose exec web rails db:migrate${NC}"
echo ""
echo "📚 Documentation:"
echo "   - docs/environment/ENV_VARIABLES_GUIDE.md - Complete guide"
echo "   - docs/auth/GOOGLE_OAUTH_SETUP.md - Google OAuth setup"
echo "   - docs/security/SECURITY_REPORT.md - Security best practices"
echo ""
echo -e "${GREEN}🎉 Happy coding!${NC}"
echo ""
