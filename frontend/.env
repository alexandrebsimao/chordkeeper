# =====================================
# Frontend Environment Variables
# =====================================
# Este é um arquivo de EXEMPLO para o frontend React/Vite
# Copie para .env e ajuste os valores conforme necessário

# ==================================
# API CONFIGURATION
# ==================================

NODE_ENV=development

# URL base da API backend
# Em desenvolvimento, aponta para o servidor Rails local
VITE_API_URL=http://localhost:3000

# ==================================
# NOTAS
# ==================================
#
# 1. Variáveis no Vite devem começar com VITE_ para serem expostas
# 2. Estas variáveis são públicas e visíveis no bundle do frontend
# 3. Nunca coloque secrets ou chaves privadas aqui!
# 4. Reinicie o servidor de desenvolvimento após mudanças
#
# ==================================
# AMBIENTES
# ==================================
#
# Desenvolvimento (.env):
# VITE_API_URL=http://localhost:3000
#
# Produção (.env.production):
# VITE_API_URL=http://localhost:3000
#
# Staging (.env.staging):
# VITE_API_URL=http://localhost:3000
#
